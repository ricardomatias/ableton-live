{
	"compilerOptions": {
		"outDir": "./build",
		"rootDir": "./lib",
		"target": "ES6",
		"module": "ES6",
		"moduleResolution": "bundler",
		"types": ["node"],
		"strict": true,
		"declaration": true,
		"esModuleInterop": true,
		"allowJs": false,
		"noImplicitAny": false,
		"strictPropertyInitialization": false
	},
	"include": ["lib"],
	"exclude": ["node_modules", "external", "test"],
	"typedocOptions": {
		"exclude": "node_modules|build",
		"out": "docs",
		"entryPointStrategy": "resolve"
	}
}
